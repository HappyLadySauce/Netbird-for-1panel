[Unit]
Description=Update the NetBird Linux agent
Documentation=https://docs.netbird.io/how-to/update
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/bin/netbird

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/netbird-agent-auto-update
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
